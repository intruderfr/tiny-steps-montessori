---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base
  title="Page Not Found"
  description="That page does not exist. Here are the pages parents usually want at Tiny Steps Montessori, Dehiwala."
  noindex
>
  <section class="nf">
    <div class="wrap nf__inner">
      <div class="nf__art" aria-hidden="true">
        <svg viewBox="0 0 240 180">
          <circle cx="120" cy="90" r="76" fill="var(--sun-soft)" />
          {/* a small trail of footprints wandering off */}
          <ellipse cx="70" cy="128" rx="9" ry="14" fill="var(--sun-deep)" opacity="0.55" transform="rotate(-18 70 128)" />
          <ellipse cx="94" cy="140" rx="9" ry="14" fill="var(--sun-deep)" opacity="0.4" transform="rotate(-18 94 140)" />
          <ellipse cx="118" cy="130" rx="9" ry="14" fill="var(--sun-deep)" opacity="0.28" transform="rotate(-18 118 130)" />
          <ellipse cx="144" cy="144" rx="9" ry="14" fill="var(--sun-deep)" opacity="0.18" transform="rotate(-18 144 144)" />
          <circle cx="120" cy="72" r="26" fill="#e8b98f" />
          <path d="M99 68a21 21 0 0 1 42 0Z" fill="#3c2a20" />
          <circle cx="112" cy="76" r="3.2" fill="var(--ink)" />
          <circle cx="129" cy="76" r="3.2" fill="var(--ink)" />
          <path d="M113 88q7 5 14 0" stroke="var(--ink)" stroke-width="2.6" fill="none" stroke-linecap="round" />
        </svg>
      </div>

      <p class="eyebrow eyebrow--sun">Error 404</p>
      <h1 class="h1 nf__t">This page wandered off</h1>
      <p class="lede nf__d">
        We could not find that page. It may have moved, or the link may have a
        typo in it. Here is where most parents are heading:
      </p>

      <ul class="nf__links">
        <li><a href="/programmes">Our programmes, ages 1–8</a></li>
        <li><a href="/admissions">Admissions &amp; fees</a></li>
        <li><a href="/news">News &amp; parent guides</a></li>
        <li><a href="/faq">Questions parents ask</a></li>
        <li><a href="/contact">Visit &amp; contact us</a></li>
      </ul>

      <div class="nf__cta">
        <a href="/" class="btn btn--primary btn--lg">Back to the home page</a>
        <a href={site.phoneHref} class="btn btn--ghost btn--lg">Call {site.phone}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { padding-block: clamp(2.5rem, 1rem + 6vw, 5rem); }
  .nf__inner { max-width: 620px; margin-inline: auto; text-align: center; }
  .nf__art { max-width: 260px; margin: 0 auto 1.5rem; }
  .nf__t { font-size: var(--t-3xl); margin-block: 0.8rem 1rem; }
  .nf__d { margin-inline: auto; }
  .nf__links { list-style: none; padding: 0; margin: 2rem 0; display: grid; gap: 0.5rem; }
  .nf__links a {
    display: block; background: var(--paper); border: 1px solid var(--line);
    border-radius: var(--r-md); padding: 0.85rem 1.2rem; text-decoration: none;
    font-weight: 600; color: var(--ink-2); transition: all 0.2s;
  }
  .nf__links a:hover { border-color: var(--sun); color: var(--ink); transform: translateX(4px); }
  .nf__cta { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; }
</style>
