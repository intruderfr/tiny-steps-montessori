---
import Base from '../../layouts/Base.astro';
import ProfileCard from '../../components/kids/ProfileCard.astro';
import MemorySequence from '../../components/games/MemorySequence.astro';
import PatternFinder from '../../components/games/PatternFinder.astro';
import OddOneOut from '../../components/games/OddOneOut.astro';
import MakeTen from '../../components/games/MakeTen.astro';
import KnowledgeChallenge from '../../components/games/KnowledgeChallenge.astro';
import TellTheTime from '../../components/games/TellTheTime.astro';
import { site, abs } from '../../data/site';
import { faqSchema } from '../../data/schema';
import { CHALLENGES, GROUPS, challengesIn } from '../../scripts/progress';
import { FREE_STAGES } from '../../scripts/access';
import '../../styles/games.css';

const totalStages = CHALLENGES.reduce((n, c) => n + c.stages, 0);

const faqs = [
  {
    q: 'Which parts are free?',
    a: `Stages 1 to ${FREE_STAGES} of all ${CHALLENGES.length} challenges are free for everybody, with no sign-up. That is ${CHALLENGES.length * FREE_STAGES} stages. The whole Kids Corner — sink or float, the tower, the memory game and counting — is free too, with no limit.`,
  },
  {
    q: 'How do enrolled families unlock the rest?',
    a: `Families enrolled at Tiny Steps are given a family code. Enter it once on this page and stages ${FREE_STAGES + 1} onwards open on that device and stay open. One code covers the whole family.`,
  },
  {
    q: 'I have lost our family code.',
    a: 'Ask us at the gate, call us, or send a WhatsApp message and we will send it again. It is the same code for the whole school year.',
  },
  {
    q: 'How do the stages work?',
    a: 'Each challenge has eight stages that get harder. Stage 1 is always open; finishing it opens stage 2, and so on. Nothing ever re-locks, and any stage you have opened can be replayed as many times as you like.',
  },
  {
    q: 'Is my child being scored?',
    a: 'No. There is no score, no timer, no lives and no way to fail. A wrong answer wobbles and the child tries again. The only thing recorded is which stages have been finished.',
  },
  {
    q: 'Where is the progress stored?',
    a: 'On your own device, in the browser, and nowhere else. There is no account and no server. We never see it, and it cannot follow your child to another device or another browser.',
  },
  {
    q: 'What ages are the challenges for?',
    a: 'Roughly 4 to 8. The early stages suit a four-year-old; the later stages of Make Ten, Tell the Time and What Comes Next? will stretch a seven or eight-year-old.',
  },
];
---

<Base
  title="Brain Challenges & Learning Games"
  description={`Eight staged challenges for children aged 4–8 — memory, logic, phonics, shapes, telling the time and Sri Lanka. Stages 1–${FREE_STAGES} free for everyone.`}
  crumbs={[
    { name: 'Kids Corner', href: '/kids' },
    { name: 'Challenges', href: '/kids/challenges' },
  ]}
  schemaNodes={[
    faqSchema(faqs),
    {
      '@type': 'WebApplication',
      '@id': abs('/kids/challenges#app'),
      name: `${site.name} Brain Challenges`,
      applicationCategory: 'EducationalApplication',
      operatingSystem: 'Any browser',
      description: `${CHALLENGES.length} staged learning challenges for children aged 4 to 8, covering working memory, logic, reasoning, number bonds, phonics, shapes, telling the time and Sri Lankan general knowledge.`,
      url: abs('/kids/challenges'),
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'LKR' },
      publisher: { '@id': abs('/#school') },
      audience: { '@type': 'PeopleAudience', suggestedMinAge: 4, suggestedMaxAge: 8 },
    },
  ]}
>
  <header class="chead">
    <div class="wrap chead__inner">
      <p class="eyebrow eyebrow--navy">Challenges</p>
      <h1 class="h1 chead__t">Eight challenges. {totalStages} stages.</h1>
      <p class="lede chead__d">
        Four that build how your child <em>thinks</em>, and four that build what
        they <em>know</em>. Nothing is timed, nothing is scored, and you can go
        back to any stage as often as you want.
      </p>
      <p class="chead__free">
        Stages 1–{FREE_STAGES} are free for everyone · stages {FREE_STAGES + 1}–8
        are for enrolled families
      </p>
    </div>
  </header>

  <div class="wrap chome">
    <ProfileCard />

    {/* Enrolled families land here and put their code in straight away. */}
    <div class="unlockbar" id="unlockBar">
      <span id="unlockText">
        <strong>Enrolled at Tiny Steps?</strong> Enter your family code to open
        every stage.
      </span>
      <button class="btn btn--primary btn--sm" type="button" id="unlockBtn">Enter family code</button>
    </div>

    {(['brain', 'knowledge'] as const).map((group) => (
      <section class="cgroup">
        <header class="cgroup__head">
          <h2 class="cgroup__h">{GROUPS[group].label}</h2>
          <p class="cgroup__blurb">{GROUPS[group].blurb}</p>
        </header>

        <nav class="picker" aria-label={`Jump to a ${GROUPS[group].label.toLowerCase()} challenge`}>
          {challengesIn(group).map((c) => (
            <a href={`#ch-${c.id}`} class="picker__item">
              <span class="picker__icon" aria-hidden="true">{c.icon}</span>
              <span class="picker__text">
                <span class="picker__name">{c.name}</span>
                <span class="picker__area">{c.skill}</span>
              </span>
            </a>
          ))}
        </nav>

        <div class="cgames">
          {group === 'brain' ? (
            <>
              <MemorySequence />
              <PatternFinder />
              <OddOneOut />
              <MakeTen />
            </>
          ) : (
            <>
              <KnowledgeChallenge
                id="sounds"
                name="First Sounds"
                icon="🔤"
                kicker="Letters and sounds"
                how="Say the picture's name in your head, then listen to the sound it starts with."
                tint="var(--red-soft)"
                accent="var(--red-deep)"
                real="<strong>Away from the screen:</strong> play I-spy with sounds rather than letters — &ldquo;I spy something starting with mmm&rdquo;. Sounds come before letter names."
              />
              <KnowledgeChallenge
                id="shapes"
                name="Shape Detective"
                icon="🔷"
                kicker="Shapes and geometry"
                how="Find the shape, then count its sides and corners. Later on, the solid ones turn up."
                tint="var(--teal-soft)"
                accent="var(--teal-deep)"
                real="<strong>Away from the screen:</strong> hunt for shapes on the walk home — road signs, windows, wheels, tiles. Naming them in the wild beats naming them on a worksheet."
              />
              <TellTheTime />
              <KnowledgeChallenge
                id="lanka"
                name="My Sri Lanka"
                icon="🇱🇰"
                kicker="Our island"
                how="Our animals, our cities, our festivals and our national symbols."
                tint="var(--yellow-soft)"
                accent="var(--yellow-text)"
                real="<strong>Away from the screen:</strong> put a map of Sri Lanka on the wall and mark the places your family has been. Children hold geography far better when it is their own."
              />
            </>
          )}
        </div>
      </section>
    ))}
  </div>

  {/* ------------------------------------------------------- note to parents */}
  <section class="section parents">
    <div class="wrap wrap-narrow">
      <div class="parents__card">
        <p class="eyebrow">For Parents</p>
        <h2 class="h2 parents__t">What is free, what is not, and what we record</h2>
        <div class="prose parents__body">
          <p>
            <strong>Stages 1–{FREE_STAGES} of every challenge are free</strong>,
            for anyone, with no sign-up — that is {CHALLENGES.length * FREE_STAGES} stages.
            The whole <a href="/kids">Kids Corner</a> is free without limit. Stages
            {' '}{FREE_STAGES + 1}–8 are one of the things that come with a place
            at Tiny Steps.
          </p>
          <p>
            We should be plain about the mechanism: the family code is a
            <strong> soft lock</strong>. It is checked in your browser, so a
            determined adult with developer tools could get past it. We are not
            pretending otherwise. It exists so that enrolled families get
            something real, not to defend a vault.
          </p>
          <p>And these still hold, everywhere on the site:</p>
          <ul>
            <li><strong>No score and no timer.</strong> Nothing measures your child or hurries them.</li>
            <li><strong>No streaks, coins or badges.</strong> Come back in a month and nothing is lost.</li>
            <li><strong>Nothing re-locks.</strong> A stage you have opened stays open.</li>
            <li><strong>Nothing leaves the device.</strong> No account, no server, no analytics on these pages. Delete it all in one tap from <a href="/kids/progress">My Journey</a>.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-soft edge-top">
    <div class="wrap wrap-narrow">
      <h2 class="h2 center" style="margin-bottom:2rem">Questions about the challenges</h2>
      <div class="faq">
        {faqs.map((f) => (
          <details class="faq__item" name="ch-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <p class="center" style="margin-top:2rem">
        <a href="/kids" class="btn btn--ghost">← Back to the Kids Corner</a>
      </p>
    </div>
  </section>

  {/* ------------------------------------------------------------- the wall */}
  <dialog class="gate" id="gate" aria-labelledby="gateH">
    <button class="gate__close" type="button" id="gateClose" aria-label="Close">&times;</button>
    <div class="gate__inner">
      <div class="gate__key" aria-hidden="true">🔑</div>
      <h2 class="gate__h" id="gateH">This stage is for enrolled families</h2>
      <p class="gate__p">
        Stages 1–{FREE_STAGES} are free for everyone. Stages {FREE_STAGES + 1}–8
        of all {CHALLENGES.length} challenges — {CHALLENGES.length * (8 - FREE_STAGES)} more
        stages — come with a place at Tiny Steps Montessori in Dehiwala.
      </p>

      <form class="gate__form" id="gateForm">
        <label for="gateCode" class="gate__p" style="margin:0">
          <strong>Already with us?</strong> Enter your family code:
        </label>
        <div class="gate__row">
          <input
            class="gate__input"
            id="gateCode"
            type="text"
            autocomplete="off"
            autocapitalize="characters"
            spellcheck="false"
            placeholder="FAMILY CODE"
            aria-describedby="gateMsg"
          />
          <button class="btn btn--primary" type="submit">Unlock</button>
        </div>
        <p class="gate__msg" id="gateMsg" role="status" aria-live="polite"></p>
      </form>

      <p class="gate__p">
        Not with us yet? Come and see the school on a weekday morning — the
        classrooms will be running and the children will be in them.
      </p>
      <div class="gate__cta">
        <a href="/contact#visit" class="btn btn--teal">Book a school visit</a>
        <a href="/admissions" class="btn btn--ghost">Fees &amp; admissions</a>
      </div>
    </div>
  </dialog>
</Base>

<style>
  .chead { padding-block: clamp(1.6rem, 1rem + 3vw, 3rem) clamp(1.2rem, 1rem + 1.5vw, 2rem); }
  .chead__inner { text-align: center; max-width: 720px; }
  .chead__t { font-size: var(--t-3xl); margin-block: 0.8rem 1rem; }
  .chead__d { margin-inline: auto; }
  .chead__free {
    display: inline-block; margin-top: 1.1rem; font-size: var(--t-sm); font-weight: 600;
    background: var(--surface-2); border-radius: var(--r-full); padding: 0.45rem 1.1rem; color: var(--ink-2);
  }

  .chome { display: grid; gap: clamp(1.4rem, 1rem + 2vw, 2.4rem); padding-bottom: var(--section-y); }

  .cgroup { display: grid; gap: 1.2rem; }
  .cgroup__head { text-align: center; max-width: 60ch; margin-inline: auto; }
  .cgroup__h { font-family: var(--font-display); font-size: var(--t-2xl); }
  .cgroup__blurb { font-size: var(--t-sm); color: var(--ink-2); margin-top: 0.4rem; }

  .picker { display: flex; flex-wrap: wrap; gap: 0.7rem; justify-content: center; }
  .picker__item {
    display: flex; align-items: center; gap: 0.65rem; text-decoration: none;
    background: var(--paper); border: 2px solid var(--line); border-radius: var(--r-full);
    padding: 0.5rem 1.1rem 0.5rem 0.6rem;
    transition: transform 0.22s var(--ease-bounce), border-color 0.2s, box-shadow 0.2s;
  }
  .picker__item:hover { transform: translateY(-3px); border-color: var(--yellow); box-shadow: var(--sh-md); }
  .picker__icon { font-size: 1.5rem; width: 42px; height: 42px; display: grid; place-items: center; background: var(--surface-2); border-radius: var(--r-full); }
  .picker__text { display: grid; text-align: left; line-height: 1.2; }
  .picker__name { font-family: var(--font-display); font-weight: 700; font-size: 1rem; color: var(--ink); }
  .picker__area { font-size: var(--t-xs); color: var(--ink-3); }

  .cgames { display: grid; gap: clamp(1.5rem, 1rem + 2.5vw, 2.6rem); }

  .parents { padding-top: 0; }
  .parents__card {
    background: var(--navy); color: #fff; border-radius: var(--r-2xl);
    padding: clamp(1.6rem, 1rem + 3vw, 3rem);
  }
  .parents__card .eyebrow { background: rgba(255, 255, 255, 0.16); color: #fff; }
  .parents__t { color: #fff; margin-block: 0.8rem 1.2rem; font-size: var(--t-2xl); }
  .parents__body { color: rgba(255, 255, 255, 0.93); max-width: none; font-size: var(--t-base); }
  .parents__body a { color: var(--yellow); }
  .parents__body strong { color: #fff; }
  .parents__body li::marker { color: var(--yellow); }

  .faq { display: grid; gap: 0.75rem; }
  .faq__item { background: var(--paper); border: 1px solid var(--line); border-radius: var(--r-md); overflow: hidden; }
  .faq__item summary {
    cursor: pointer; padding: 1.1rem 1.3rem; font-family: var(--font-display); font-weight: 700;
    font-size: 1.05rem; list-style: none; display: flex; justify-content: space-between; gap: 1rem; align-items: center;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after { content: '+'; font-size: 1.5rem; color: var(--yellow-deep); flex: none; transition: transform 0.25s; }
  .faq__item[open] summary::after { transform: rotate(45deg); }
  .faq__item p { padding: 0 1.3rem 1.2rem; color: var(--ink-2); font-size: var(--t-sm); line-height: 1.7; }
</style>

<script>
  import { GATE_EVENT } from '../../scripts/stage-game';
  import { redeem, hasAccess, signOut, onAccessChange } from '../../scripts/access';
  import { sfxYes, sfxNudge } from '../../scripts/playful';

  const gate = document.getElementById('gate') as HTMLDialogElement | null;
  const form = document.getElementById('gateForm') as HTMLFormElement | null;
  const input = document.getElementById('gateCode') as HTMLInputElement | null;
  const msg = document.getElementById('gateMsg');
  const bar = document.getElementById('unlockBar');
  const barText = document.getElementById('unlockText');
  const barBtn = document.getElementById('unlockBtn');

  const open = () => {
    if (!gate?.open) gate?.showModal();
    window.setTimeout(() => input?.focus(), 60);
  };

  // Raised by any challenge when a gated stage is tapped.
  window.addEventListener(GATE_EVENT, open);
  barBtn?.addEventListener('click', () => (hasAccess() ? signOut() : open()));
  document.getElementById('gateClose')?.addEventListener('click', () => gate?.close());
  gate?.addEventListener('click', (e) => {
    if (e.target === gate) gate.close();
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!input || !msg) return;
    msg.className = 'gate__msg';
    msg.textContent = 'Checking…';

    const ok = await redeem(input.value);
    if (ok) {
      sfxYes();
      msg.className = 'gate__msg is-good';
      msg.textContent = 'That is the one — every stage is open now.';
      input.value = '';
      window.setTimeout(() => gate?.close(), 1100);
    } else {
      sfxNudge();
      msg.className = 'gate__msg is-bad';
      msg.textContent = 'That code did not work. Check with us and try again.';
    }
  });

  /** Reflect access state in the strip at the top of the page. */
  const paintBar = () => {
    const on = hasAccess();
    bar?.classList.toggle('unlockbar--on', on);
    if (barText) {
      barText.innerHTML = on
        ? '<strong>Family code accepted.</strong> Every stage is open on this device.'
        : '<strong>Enrolled at Tiny Steps?</strong> Enter your family code to open every stage.';
    }
    if (barBtn) barBtn.textContent = on ? 'Sign out of this device' : 'Enter family code';
  };

  onAccessChange(paintBar);
  paintBar();
</script>
