---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { faqSchema } from '../../data/schema';

const programmes = (await getCollection('programmes')).sort((a, b) => a.data.order - b.data.order);

const faqs = [
  {
    q: 'Which programme is right for my child?',
    a: 'It is mostly age. Playgroup for 1–2 year olds, Montessori for 2–5, STEM Club for 5–8 on Saturdays. If your child sits on a boundary, come and visit both rooms and we will tell you honestly which we think fits.',
  },
  {
    q: 'Can my child join partway through the year?',
    a: 'Yes, subject to space. Mixed-age Montessori classrooms absorb new children more easily than same-age classes, because there is no fixed group starting point to catch up with.',
  },
  {
    q: 'Do you offer half days?',
    a: 'Playgroup is a half day by design (8:30–11:30). The Montessori programme runs 8:00–12:30, and our daycare extends that to 5:00 PM for families who need it.',
  },
  {
    q: 'Does my child need to attend the preschool to join STEM Club?',
    a: 'No. STEM Club runs on Saturday mornings and is open to any child aged 5–8, including children at other primary schools nearby.',
  },
];
---

<Base
  title="Programmes for Ages 1 to 8"
  description="Playgroup, Montessori, STEM Club and daycare in Dehiwala. Published ratios, real hours and what each programme actually involves for children aged 1 to 8."
  crumbs={[{ name: 'Programmes', href: '/programmes' }]}
  schemaNodes={[faqSchema(faqs)]}
>
  <header class="phead">
    <div class="wrap">
      <p class="eyebrow eyebrow--navy">Ages 1 to 8</p>
      <h1 class="h1 phead__t">Four programmes, one idea: follow the child</h1>
      <p class="lede">
        Every programme is built around what a child of that age genuinely needs.
        We publish the ratio and the hours for each one, because those are the two
        numbers that actually determine the quality of your child's day.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="wrap plist">
      {programmes.map((p, i) => (
        <article class={`prow reveal d${(i % 4) + 1}`} data-accent={p.data.accent}>
          <div class="prow__mark" aria-hidden="true">
            <span class="prow__icon">{p.data.icon}</span>
          </div>
          <div class="prow__body">
            <p class="prow__age">{p.data.ageLabel}</p>
            <h2 class="h3 prow__t">
              <a href={`/programmes/${p.id}`}>{p.data.shortTitle}</a>
            </h2>
            <p class="prow__d">{p.data.description}</p>

            <ul class="prow__high">
              {p.data.highlights.slice(0, 3).map((h) => (
                <li>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2Z"/></svg>
                  {h}
                </li>
              ))}
            </ul>

            <a href={`/programmes/${p.id}`} class="btn btn--ghost btn--sm">Full details &rarr;</a>
          </div>

          <dl class="prow__facts">
            <div><dt>Hours</dt><dd>{p.data.schedule}</dd></div>
            <div><dt>Ratio</dt><dd>{p.data.ratio}</dd></div>
            <div><dt>Group size</dt><dd>{p.data.capacity}</dd></div>
          </dl>
        </article>
      ))}
    </div>
  </section>

  <section class="section bg-soft edge-top">
    <div class="wrap wrap-narrow">
      <h2 class="h2 center" style="margin-bottom:2rem">Questions about programmes</h2>
      <div class="faq">
        {faqs.map((f) => (
          <details class="faq__item" name="prog-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <p class="center" style="margin-top:2.5rem">
        <a href="/contact#visit" class="btn btn--primary btn--lg">Book a visit</a>
      </p>
      <p class="center" style="margin-top:1rem;font-size:var(--t-sm);color:var(--ink-2)">
        Or call us on <a href={site.phoneHref}>{site.phone}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .phead { padding-block: clamp(1.6rem, 1rem + 3vw, 3rem) 0; }
  .phead__t { font-size: var(--t-3xl); margin-block: 0.8rem 1rem; max-width: 20ch; }
  .phead .lede { max-width: 62ch; }

  .plist { display: grid; gap: var(--s-5); }
  .prow {
    display: grid; grid-template-columns: 92px minmax(0, 1fr) 220px; gap: 1.8rem;
    background: var(--paper); border: 1px solid var(--line); border-left: 6px solid var(--ac, var(--yellow));
    border-radius: var(--r-lg); padding: clamp(1.3rem, 1rem + 1.5vw, 2rem);
    align-items: start; transition: box-shadow 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .prow:hover { box-shadow: var(--sh-md); transform: translateY(-3px); }
  @media (max-width: 900px) { .prow { grid-template-columns: 68px minmax(0, 1fr); } .prow__facts { grid-column: 1 / -1; } }
  @media (max-width: 520px) { .prow { grid-template-columns: 1fr; } }

  .prow[data-accent='yellow']   { --ac: var(--yellow);   --soft: var(--yellow-soft);  --ac-text: var(--yellow-text);}
  .prow[data-accent='teal']  { --ac: var(--teal);  --soft: var(--teal-soft);  --ac-text: var(--teal-text);}
  .prow[data-accent='red'] { --ac: var(--red); --soft: var(--red-soft);  --ac-text: var(--red-text);}
  .prow[data-accent='green']  { --ac: var(--green);  --soft: var(--green-soft);  --ac-text: var(--green-text);}
  .prow[data-accent='navy']  { --ac: var(--navy);  --soft: var(--navy-soft);  --ac-text: var(--navy-text);}
  .prow[data-accent='sky']   { --ac: var(--sky);   --soft: var(--sky-soft);  --ac-text: var(--sky-text);}

  .prow__mark { width: 72px; height: 72px; display: grid; place-items: center; background: var(--soft); border-radius: var(--r-md); }
  .prow__icon { font-size: 2rem; }
  .prow__age { font-size: var(--t-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--ac-text); }
  .prow__t { margin-block: 0.25rem 0.6rem; }
  .prow__t a { text-decoration: none; }
  .prow__t a:hover { color: var(--ac-text); }
  .prow__d { color: var(--ink-2); font-size: var(--t-sm); line-height: 1.65; max-width: 62ch; }
  .prow__high { list-style: none; padding: 0; margin: 1.1rem 0 1.4rem; display: grid; gap: 0.5rem; }
  .prow__high li { display: flex; gap: 0.55rem; font-size: var(--t-sm); color: var(--ink-2); line-height: 1.5; }
  .prow__high svg { width: 17px; height: 17px; fill: var(--ac); flex: none; margin-top: 3px; }

  .prow__facts { display: grid; gap: 0.85rem; background: var(--surface-2); padding: 1.1rem; border-radius: var(--r-md); }
  .prow__facts dt { font-size: var(--t-xs); text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-3); }
  .prow__facts dd { margin: 0.15rem 0 0; font-weight: 700; font-size: var(--t-sm); }

  .faq { display: grid; gap: 0.75rem; }
  .faq__item { background: var(--paper); border: 1px solid var(--line); border-radius: var(--r-md); overflow: hidden; }
  .faq__item summary {
    cursor: pointer; padding: 1.1rem 1.3rem; font-family: var(--font-display); font-weight: 700;
    font-size: 1.05rem; list-style: none; display: flex; justify-content: space-between; gap: 1rem; align-items: center;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after { content: '+'; font-size: 1.5rem; color: var(--yellow-deep); flex: none; transition: transform 0.25s; }
  .faq__item[open] summary::after { transform: rotate(45deg); }
  .faq__item p { padding: 0 1.3rem 1.2rem; color: var(--ink-2); font-size: var(--t-sm); line-height: 1.7; }
</style>
