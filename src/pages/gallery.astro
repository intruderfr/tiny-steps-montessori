---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import { site, abs } from '../data/site';
import { photos, categories, videos } from '../data/gallery';

/**
 * Eagerly glob the photo folder so each entry in gallery.ts resolves to a real
 * ImageMetadata object. Astro then generates responsive WebP variants at build
 * time — the 2000px source is never actually shipped to a browser.
 */
const files = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/photos/*.jpg',
  { eager: true }
);

const found = photos
  .map((p) => ({ ...p, img: files[`/src/assets/photos/${p.slug}.jpg`]?.default }))
  .filter((p) => {
    if (!p.img) console.warn(`[gallery] missing image for slug "${p.slug}"`);
    return Boolean(p.img);
  });

/**
 * The lightbox needs a big version, and `img.src` is NOT it — that property
 * points at the untouched source JPEG, so using it would hand the visitor a
 * ~400 KB unoptimised file. getImage() builds a properly compressed WebP for
 * the enlarged view instead.
 */
const resolved = await Promise.all(
  found.map(async (p) => ({
    ...p,
    full: (await getImage({ src: p.img, width: 1200, format: 'webp', quality: 76 })).src,
  }))
);

// Featured first, so the strongest frames land above the fold.
const ordered = [...resolved].sort((a, b) => Number(b.featured ?? 0) - Number(a.featured ?? 0));

const counts = Object.fromEntries(
  categories.map((c) => [c, resolved.filter((p) => p.category === c).length])
);

// ImageGallery markup gives Google an explicit list of every image and its
// caption, which is what makes a local school competitive in image search.
const gallerySchema = {
  '@type': 'ImageGallery',
  '@id': abs('/gallery#gallery'),
  name: `${site.name} — Photo Gallery`,
  description: `Photographs of daily life, trips, science and celebrations at ${site.name} in Dehiwala.`,
  isPartOf: { '@id': abs('/#website') },
  image: resolved.slice(0, 20).map((p) => ({
    '@type': 'ImageObject',
    contentUrl: abs(p.full),
    caption: p.caption ?? p.alt,
    description: p.alt,
  })),
};
---

<Base
  title="Photo Gallery"
  description="See inside Tiny Steps Montessori in Dehiwala — real photographs of our classrooms, science club, nature trips, art and celebrations."
  crumbs={[{ name: 'Gallery', href: '/gallery' }]}
  schemaNodes={[gallerySchema]}
>
  <header class="ghead">
    <div class="wrap">
      <p class="eyebrow eyebrow--yellow">Gallery</p>
      <h1 class="h1 ghead__t">This is what a week here looks like</h1>
      <p class="lede">
        No stock photography. Every picture on this page was taken at Tiny Steps
        — in our classrooms, on our trips, and at our concerts.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="wrap">
      <div class="filters" role="group" aria-label="Filter photos by category">
        <button class="chip is-on" data-cat="all" type="button">
          All <span class="chip__n">{resolved.length}</span>
        </button>
        {categories.map((c) => (
          <button class="chip" data-cat={c} type="button">
            {c} <span class="chip__n">{counts[c]}</span>
          </button>
        ))}
      </div>

      <div class="masonry" id="grid">
        {ordered.map((p, i) => (
          <figure class="shot" data-cat={p.category} data-i={i}>
            <button
              class="shot__btn"
              type="button"
              data-full={p.full}
              data-alt={p.alt}
              data-caption={p.caption ?? ''}
              aria-label={`View larger: ${p.alt}`}
            >
              {/* width caps the fallback `src`. Without it Astro also emits a
                  full 1500px variant per photo that nothing ever requests,
                  since the srcset tops out at 720 and the lightbox has its own
                  1200px file. */}
              <Image
                src={p.img}
                alt={p.alt}
                width={720}
                widths={[320, 480, 720]}
                sizes="(max-width: 560px) 92vw, (max-width: 900px) 45vw, 30vw"
                loading={i < 6 ? 'eager' : 'lazy'}
                decoding="async"
                quality={72}
              />
              <span class="shot__cat">{p.category}</span>
            </button>
            {p.caption && <figcaption class="shot__cap">{p.caption}</figcaption>}
          </figure>
        ))}
      </div>

      <p class="empty" id="empty" hidden>No photos in that category yet.</p>
    </div>
  </section>

  {/* ------------------------------------------------------------- videos */}
  <section class="section bg-soft edge-top">
    <div class="wrap">
      <header class="sec-head center reveal">
        <p class="eyebrow">Video</p>
        <h2 class="h2">A minute inside the school</h2>
        <p class="lede center">
          Sound is off by default — turn it on if you are somewhere you can.
        </p>
      </header>

      <div class="vids">
        {videos.map((v) => (
          <figure class="vid reveal">
            {/*
              preload="none" keeps ~2.5 MB off the initial page load; the poster
              frame is what the visitor actually sees until they press play.
            */}
            <video
              controls
              playsinline
              muted
              preload="none"
              poster={v.poster}
              width={v.width}
              height={v.height}
            >
              <source src={v.src} type="video/mp4" />
              Your browser cannot play this video.
              <a href={v.src}>Download it instead.</a>
            </video>
            <figcaption>
              <strong>{v.title}</strong>
              <span>{v.description}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="wrap cta__inner">
      <h2 class="h2">Photographs only tell you so much</h2>
      <p class="cta__d">
        Come on a weekday morning and see a real work cycle, with the children in
        the room.
      </p>
      <div class="cta__btns">
        <a href="/contact#visit" class="btn btn--primary btn--lg">Book a visit</a>
        <a href={site.phoneHref} class="btn btn--white btn--lg">Call {site.phone}</a>
      </div>
    </div>
  </section>

  {/* ----------------------------------------------------------- lightbox */}
  <dialog class="lb" id="lightbox" aria-label="Photo viewer">
    <button class="lb__close" id="lbClose" type="button" aria-label="Close">&times;</button>
    <button class="lb__nav lb__nav--prev" id="lbPrev" type="button" aria-label="Previous photo">&#8249;</button>
    <figure class="lb__fig">
      <img id="lbImg" src="" alt="" loading="eager" decoding="async" />
      <figcaption id="lbCap"></figcaption>
    </figure>
    <button class="lb__nav lb__nav--next" id="lbNext" type="button" aria-label="Next photo">&#8250;</button>
  </dialog>
</Base>

<style>
  .ghead { padding-block: clamp(1.6rem, 1rem + 3vw, 3rem) 0; }
  .ghead__t { font-size: var(--t-3xl); margin-block: 0.8rem 1rem; max-width: 18ch; }
  .ghead .lede { max-width: 56ch; }

  .filters { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-bottom: 2rem; }
  .chip {
    border: 1px solid var(--line); background: var(--paper); color: var(--ink-2);
    padding: 0.5rem 1.05rem; border-radius: var(--r-full); cursor: pointer;
    font-weight: 600; font-size: var(--t-sm); transition: all 0.2s;
    display: inline-flex; align-items: center; gap: 0.45rem;
  }
  .chip:hover { border-color: var(--yellow); }
  .chip.is-on { background: var(--navy); color: #fff; border-color: var(--navy); }
  .chip__n {
    font-size: 0.72rem; background: var(--surface-2); color: var(--ink-2);
    border-radius: var(--r-full); padding: 0.05rem 0.4rem; min-width: 1.4em; text-align: center;
  }
  .chip.is-on .chip__n { background: rgba(255,255,255,0.22); color: #fff; }

  /* CSS columns give a masonry feel without any layout JS. Photos are mostly
     portrait phone shots, so a fixed grid would letterbox half of them. */
  .masonry { columns: 3 300px; column-gap: var(--s-4); }
  @media (max-width: 560px) { .masonry { columns: 2 150px; column-gap: 0.7rem; } }

  .shot { break-inside: avoid; margin: 0 0 var(--s-4); }
  .shot[hidden] { display: none; }
  .shot__btn {
    display: block; width: 100%; padding: 0; border: none; background: none;
    cursor: zoom-in; border-radius: var(--r-md); overflow: hidden; position: relative;
    box-shadow: var(--sh-sm); line-height: 0;
  }
  .shot__btn :global(img) {
    width: 100%; height: auto; display: block;
    transition: transform 0.5s var(--ease);
  }
  .shot__btn:hover :global(img) { transform: scale(1.04); }
  .shot__cat {
    position: absolute; left: 0.6rem; bottom: 0.6rem;
    background: rgba(31, 32, 51, 0.78); color: #fff; backdrop-filter: blur(4px);
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;
    padding: 0.25rem 0.6rem; border-radius: var(--r-full);
    opacity: 0; transition: opacity 0.25s;
  }
  .shot__btn:hover .shot__cat, .shot__btn:focus-visible .shot__cat { opacity: 1; }
  .shot__cap {
    font-size: var(--t-xs); color: var(--ink-2); line-height: 1.5;
    padding: 0.55rem 0.2rem 0;
  }
  .empty { text-align: center; color: var(--ink-3); padding: 3rem 0; }

  /* ---------------------------------------------------------------- video */
  .sec-head { margin-bottom: 2.5rem; max-width: 56ch; }
  .sec-head .h2 { margin-block: 0.6rem 0.8rem; }
  .vids { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--s-5); align-items: start; max-width: 920px; margin-inline: auto; }
  .vid { margin: 0; }
  .vid video {
    width: 100%; height: auto; border-radius: var(--r-lg);
    box-shadow: var(--sh-md); background: var(--navy); display: block;
  }
  .vid figcaption { font-size: var(--t-sm); color: var(--ink-2); margin-top: 0.8rem; display: grid; gap: 0.25rem; }
  .vid figcaption strong { font-family: var(--font-display); color: var(--ink); font-size: 1.05rem; }

  /* ------------------------------------------------------------- lightbox */
  .lb {
    border: none; padding: 0; max-width: 100vw; max-height: 100vh;
    width: 100%; height: 100%; background: rgba(15, 16, 28, 0.94);
    align-items: center; justify-content: center; gap: 1rem;
  }
  .lb[open] { display: flex; }
  .lb::backdrop { background: rgba(15, 16, 28, 0.9); }
  .lb__fig { margin: 0; max-width: min(1100px, 92vw); text-align: center; }
  .lb__fig img {
    max-width: 100%; max-height: 78vh; width: auto; height: auto;
    border-radius: var(--r-md); margin-inline: auto;
  }
  .lb__fig figcaption {
    color: #e8e8f2; font-size: var(--t-sm); margin-top: 1rem;
    max-width: 60ch; margin-inline: auto; line-height: 1.6;
  }
  .lb__close, .lb__nav {
    background: rgba(255,255,255,0.12); border: none; color: #fff; cursor: pointer;
    border-radius: var(--r-full); display: grid; place-items: center;
    transition: background 0.2s; flex: none;
  }
  .lb__close { position: absolute; top: 1.1rem; right: 1.1rem; width: 46px; height: 46px; font-size: 1.9rem; line-height: 1; }
  .lb__nav { width: 52px; height: 52px; font-size: 2.3rem; line-height: 1; }
  .lb__close:hover, .lb__nav:hover { background: rgba(255,255,255,0.25); }
  @media (max-width: 640px) {
    .lb__nav { position: absolute; bottom: 1.2rem; }
    .lb__nav--prev { left: 25%; }
    .lb__nav--next { right: 25%; }
  }

  .cta { background: linear-gradient(140deg, var(--yellow) 0%, #f9d95e 55%, var(--red) 130%); padding-block: clamp(3rem, 2rem + 5vw, 5rem); }
  .cta__inner { text-align: center; max-width: 640px; }
  .cta__d { font-size: var(--t-lg); color: rgba(43, 42, 95, 0.85); margin-block: 0.9rem 1.8rem; }
  .cta__btns { display: flex; flex-wrap: wrap; gap: 0.9rem; justify-content: center; }
</style>

<script>
  // ------------------------------------------------------------- filtering
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const shots = [...document.querySelectorAll<HTMLElement>('.shot')];
  const empty = document.getElementById('empty');

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const cat = chip.dataset.cat;
      chips.forEach((c) => c.classList.toggle('is-on', c === chip));
      let shown = 0;
      shots.forEach((s) => {
        const match = cat === 'all' || s.dataset.cat === cat;
        s.hidden = !match;
        if (match) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    });
  });

  // -------------------------------------------------------------- lightbox
  const lb = document.getElementById('lightbox') as HTMLDialogElement | null;
  const lbImg = document.getElementById('lbImg') as HTMLImageElement | null;
  const lbCap = document.getElementById('lbCap');
  let current = 0;

  /** Only step through what is currently visible, so filtering scopes the arrows. */
  const visible = () => shots.filter((s) => !s.hidden);

  const show = (idx: number) => {
    const list = visible();
    if (!list.length || !lb || !lbImg || !lbCap) return;
    current = (idx + list.length) % list.length;
    const btn = list[current].querySelector<HTMLButtonElement>('.shot__btn');
    if (!btn) return;
    lbImg.src = btn.dataset.full ?? '';
    lbImg.alt = btn.dataset.alt ?? '';
    lbCap.textContent = btn.dataset.caption || btn.dataset.alt || '';
    if (!lb.open) lb.showModal();
  };

  shots.forEach((s) => {
    s.querySelector('.shot__btn')?.addEventListener('click', () => show(visible().indexOf(s)));
  });

  document.getElementById('lbClose')?.addEventListener('click', () => lb?.close());
  document.getElementById('lbPrev')?.addEventListener('click', () => show(current - 1));
  document.getElementById('lbNext')?.addEventListener('click', () => show(current + 1));

  // Click the backdrop (but not the picture) to dismiss.
  lb?.addEventListener('click', (e) => {
    if (e.target === lb) lb.close();
  });
  document.addEventListener('keydown', (e) => {
    if (!lb?.open) return;
    if (e.key === 'ArrowRight') show(current + 1);
    if (e.key === 'ArrowLeft') show(current - 1);
  });
</script>
