---
/**
 * Renders one of the school's photographs by slug.
 *
 * Pages reference photos by name ("farm-visit-holding-chick") rather than
 * importing files, so swapping a picture is a one-word edit and the alt text
 * always travels with the image from src/data/gallery.ts — it can never drift
 * or be forgotten.
 *
 * Astro's <Image> does the real work: responsive WebP variants generated at
 * build time, with width/height baked in so nothing shifts as it loads.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { photoBySlug } from '../data/gallery';

interface Props {
  slug: string;
  /** Overrides the alt text from gallery.ts. Use "" for purely decorative. */
  alt?: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  /** Above-the-fold images should be eager so they are not lazy-deferred. */
  loading?: 'eager' | 'lazy';
  quality?: number;
  /** Crop to a fixed shape, e.g. "16:9" or "4:5". Omit to keep the original. */
  ratio?: string;
}

const {
  slug,
  alt,
  class: cls = '',
  widths = [400, 800, 1200],
  sizes = '(max-width: 700px) 100vw, 50vw',
  loading = 'lazy',
  quality = 78,
  ratio,
} = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/photos/*.jpg',
  { eager: true }
);

const img = files[`/src/assets/photos/${slug}.jpg`]?.default;
const meta = photoBySlug(slug);

// Fail loudly at build time rather than shipping a broken <img>.
if (!img) {
  throw new Error(
    `<Photo slug="${slug}"> — no file at src/assets/photos/${slug}.jpg. ` +
      `Run: node scripts/import-photos.mjs`
  );
}

const altText = alt ?? meta?.alt ?? '';
if (altText === '' && alt === undefined) {
  console.warn(`[Photo] "${slug}" has no alt text in src/data/gallery.ts`);
}
---

{
  ratio ? (
    <Image
      src={img}
      alt={altText}
      class={cls}
      widths={widths}
      sizes={sizes}
      loading={loading}
      decoding="async"
      quality={quality}
      style={`aspect-ratio:${ratio.replace(':', '/')};object-fit:cover;`}
    />
  ) : (
    <Image
      src={img}
      alt={altText}
      class={cls}
      widths={widths}
      sizes={sizes}
      loading={loading}
      decoding="async"
      quality={quality}
    />
  )
}
