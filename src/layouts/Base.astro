---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { graph, schoolSchema, websiteSchema, breadcrumbSchema } from '../data/schema';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  noindex?: boolean;
  /** Extra JSON-LD nodes merged into the page graph (FAQ, Article, Course…). */
  schemaNodes?: object[];
  /** Breadcrumb trail. Home is prepended automatically. */
  crumbs?: { name: string; href: string }[];
}

const {
  title,
  description,
  image,
  type = 'website',
  publishedAt,
  updatedAt,
  noindex = false,
  schemaNodes = [],
  crumbs,
} = Astro.props;

// The school + website nodes appear on EVERY page, keyed by @id, so Google sees
// one consistent entity across the whole site rather than many partial ones.
const nodes: object[] = [schoolSchema(), websiteSchema()];
if (crumbs?.length) nodes.push(breadcrumbSchema([{ name: 'Home', href: '/' }, ...crumbs]));
nodes.push(...schemaNodes);
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      type={type}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
      noindex={noindex}
      schema={graph(...nodes)}
    />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />

    {/* Visible breadcrumbs mirror the JSON-LD trail — Google cross-checks them. */}
    {crumbs?.length ? (
      <nav class="crumbs" aria-label="Breadcrumb">
        <div class="wrap">
          <ol>
            <li><a href="/">Home</a></li>
            {crumbs.map((c, i) => (
              <li>
                {i === crumbs.length - 1 ? (
                  <span aria-current="page">{c.name}</span>
                ) : (
                  <a href={c.href}>{c.name}</a>
                )}
              </li>
            ))}
          </ol>
        </div>
      </nav>
    ) : null}

    <main id="main"><slot /></main>
    <Footer />

    <style>
      body { display: flex; flex-direction: column; min-height: 100vh; }
      main { flex: 1; }
      .crumbs { padding-block: 0.9rem 0; font-size: var(--t-sm); }
      .crumbs ol { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; }
      .crumbs li + li::before { content: '/'; margin-right: 0.5rem; color: var(--ink-3); }
      .crumbs a { color: var(--ink-3); text-decoration: none; }
      .crumbs a:hover { color: var(--teal-deep); text-decoration: underline; }
      .crumbs [aria-current] { color: var(--ink-2); font-weight: 600; }
    </style>

    <script>
      // Scroll-reveal, shared by every page. IntersectionObserver is cheap and
      // we unobserve after the first hit so it costs nothing while scrolling.
      const els = document.querySelectorAll('.reveal');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
